# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# See CLAUDE.md "Environment Variables" for the full per-script matrix.

# === Gemini (themes, prompts, copy) ===
GEMINI_API_KEY=

# === FAL.ai (image generation) ===
FAL_KEY=

# === ImgBB (image hosting) ===
IMGBB_API_KEY=

# === Gmail (notifications) ===
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Override the deep-link host in notification emails (default: http://localhost:8501)
LOCAL_APP_URL=

# === Printify (draft creation) ===
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# === Product economics (script 06 — all optional, defaults shown) ===
# Printify catalog choice: blueprint 6 = Gildan 5000, provider 99 = Printify Choice.
PRINTIFY_BLUEPRINT_ID=6
PRINTIFY_PRINT_PROVIDER_ID=99
# Retail price per variant in cents (2499 = $24.99).
POD_PRICE_CENTS=2499
# Enabled color x size grid — comma-separated, must match Printify variant titles.
POD_VARIANT_COLORS=Black,White
POD_VARIANT_SIZES=S,M,L,XL
# Front print-area scale (0-1).
POD_PRINT_SCALE=0.8

# === Etsy v3 REST (market research + stats sync) ===
ETSY_API_KEY=
# Static bearer token (expires after 1h — prefer ETSY_REFRESH_TOKEN below,
# which auto-refreshes on every run via src/etsy_auth.py).
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# === Automation gates (see AUTOMATION.md) — 1/true to open a gate ===
# Prompt gate: approving prompts spends FAL image credits. Default: human approves.
AUTO_APPROVE_PROMPTS=0
# Image gate: auto-approve images whose Gemini pre-screen score >= min score.
AUTO_APPROVE_IMAGES=0
AUTO_APPROVE_IMAGE_MIN_SCORE=8
AUTO_REJECT_IMAGE_MAX_SCORE=3
# Publish gate: publishing costs Etsy's $0.20 listing fee. Default: human approves.
AUTO_PUBLISH=0

# === Approval app remote deployment (optional) ===
# GitHub fine-grained PAT (contents: read/write) so the app's git pull/push
# buttons work when hosted off-machine (e.g. Streamlit Community Cloud).
GIT_PUSH_TOKEN=

# OAuth refresh token (90-day lifetime, scope listings_r) — used by
# src/etsy_auth.py to mint a fresh access token on every stats run, and by
# the optional Etsy MCP layer below.
ETSY_REFRESH_TOKEN=

# === Etsy MCP (optional richer data layer; ETSY_USE_MCP=1 to activate) ===
ETSY_USE_MCP=0
ETSY_DEFAULT_SHOP_ID=
ETSY_MCP_CMD=etsy-mcp

# === Supabase (Claude Tasks ↔ Python bridge) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Pipeline tuning ===
# Threshold for the daily Claude Task to flag a listing as a hot signal.
# growth_pct = (favorites_current - favorites_previous) / max(favorites_previous, 1)
HOT_SIGNAL_THRESHOLD=0.20

# Override the pod.db file location (default: ./pod.db).
POD_DB_PATH=
