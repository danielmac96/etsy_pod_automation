{
  "mcpServers": {
    "etsy": {
      "command": "node",
      "args": ["./mcp/etsy-mcp-server/build/index.js"],
      "env": {
        "ETSY_API_KEY": "${ETSY_API_KEY}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}